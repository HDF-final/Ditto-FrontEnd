{
  "name": "ditto-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "test": "pnpm test:navigation && pnpm test:navigation-assets && pnpm test:place-category && pnpm test:scan-location && pnpm test:preferences && pnpm test:i18n && pnpm test:request-language && pnpm test:image-url && pnpm test:course-detail && pnpm test:hero-image && pnpm test:css-url",
    "test:navigation": "node --test tests/navigation-routing.test.mjs",
    "test:navigation-assets": "node --test tests/navigation-assets.test.mjs",
    "test:place-category": "node --test tests/place-category.test.mjs",
    "test:scan-location": "node --test tests/scan-location.test.mjs",
    "test:preferences": "node --test tests/preference-policy.test.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "test:request-language": "node --test tests/request-language.test.mjs",
    "test:image-url": "node --test tests/image-url.test.mjs",
    "check": "pnpm lint && pnpm build",
    "test:course-detail": "node --test tests/course-detail-normalize.test.mjs",
    "test:hero-image": "node --test tests/hero-image.test.mjs",
    "test:css-url": "node --test tests/css-url.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "axios": "^1.19.0",
    "next": "16.3.0",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4"
  },
  "packageManager": "pnpm@9.12.3"
}
