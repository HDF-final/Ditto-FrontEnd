NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_LOCAL_USER_ID=

# 백엔드 주소. 브라우저의 /api/* 프록시(next.config.mjs)와 서버 사이드 fetch
# (src/lib/api/server-base-url.js)가 같은 값을 씁니다.
#
# 배포된 Spring을 그대로 쓰려면 아래 값을 두고, 로컬 Spring을 8080에 띄웠을
# 때만 http://localhost:8080 으로 바꾸세요. 로컬로 두면 뉴스·커뮤니티·AI 코스
# 추천이 전부 그쪽을 보게 되므로, 서버가 안 떠 있으면 다 같이 실패합니다.
API_PROXY_TARGET=http://hdf-spring-alb-476185930.ap-northeast-2.elb.amazonaws.com

# 실내 지도 원장(JSON)과 층 텍스처(PNG)를 CloudFront에서 받습니다.
# course-resource/* 동작이 S3 hdf-ditto-images 를 내보내고, 오브젝트에 3주짜리
# Cache-Control 이 붙어 있습니다. 백엔드의 ditto.map-assets.base-url 과 같은 곳을
# 가리켜야 합니다 (GET /api/v1/places/navigation/assets 가 같은 주소를 돌려줍니다).
#
# 비워 두면 public/ 안의 사본으로 떨어집니다 — CDN 이 막혔을 때의 안전장치입니다.
NEXT_PUBLIC_CDN_BASE=https://d1bxld598du04o.cloudfront.net/course-resource
