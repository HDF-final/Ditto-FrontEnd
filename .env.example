NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_LOCAL_USER_ID=1

# 백엔드 주소. 브라우저의 /api/* 프록시(next.config.mjs)와 서버 사이드 fetch
# (src/lib/api/server-base-url.js)가 같은 값을 씁니다.
#
# 배포된 Spring을 그대로 쓰려면 아래 값을 두고, 로컬 Spring을 8080에 띄웠을
# 때만 http://localhost:8080 으로 바꾸세요. 로컬로 두면 뉴스·커뮤니티·AI 코스
# 추천이 전부 그쪽을 보게 되므로, 서버가 안 떠 있으면 다 같이 실패합니다.
API_PROXY_TARGET=http://hdf-spring-alb-476185930.ap-northeast-2.elb.amazonaws.com
